---
import Base from "../layouts/Base.astro";
import { site } from "../lib";
---

<Base
  title="Contact"
  description="Talk to Leat Consulting about a Delivery review, a Secure delivery setup or AI code review, on GitHub or GitLab."
>
  <section class="band band--hero">
    <span class="eyebrow">Contact</span>
    <h1>Talk to us</h1>
    {site.bookingUrl ? (
      <>
        <p class="lead">Book a short call to talk through what you need.</p>
        <div class="actions"><a class="button" href={site.bookingUrl}>Book a call</a></div>
      </>
    ) : (
      <p class="lead">Booking opens shortly. In the meantime, you can follow the work on GitHub.</p>
    )}
    {site.email && <p>Or email <a href={`mailto:${site.email}`}>{site.email}</a>.</p>}
    <div class="actions"><a class="button-secondary" href={site.github}>github.com/leat-consulting</a></div>
  </section>

  <section aria-labelledby="security-heading">
    <h2 id="security-heading">Reporting a security issue</h2>
    <p>
      Please do not use the booking link or public issues. Report it privately through
      <a href="https://github.com/leat-consulting/leat-site/security/advisories/new">GitHub's private vulnerability reporting</a>.
    </p>
  </section>
</Base>
