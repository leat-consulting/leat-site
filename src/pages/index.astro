---
import Base from "../layouts/Base.astro";
import { absolute, href, packages, site } from "../lib";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.name,
  url: absolute(""),
  description: site.description,
  areaServed: site.areaServed.map((name) => ({ "@type": "Place", name })),
  sameAs: [site.github],
  knowsAbout: ["CI/CD security", "GitHub Actions", "AWS", "Terraform", "AI code review"],
};
---

<Base title={site.name} description={site.description}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <section class="hero">
    <h1>Ship quickly, without the pipeline being your weakest point</h1>
    <p class="lead">
      The systems that build and deploy your software can read your code, hold your cloud credentials
      and change production. We secure them properly, in your own repositories, then hand everything
      over for your team to own.
    </p>
    <p class="hero-actions">
      <a class="button" href={href("contact/")}>Talk to us</a>
      <a class="button-secondary" href={href("how-we-build/")}>See how we build</a>
    </p>
  </section>

  <section aria-labelledby="outcomes-heading">
    <h2 id="outcomes-heading">What changes for your team</h2>
    <ul class="outcomes">
      <li>
        <h3>Fewer ways in</h3>
        <p>Dependencies, pipelines and cloud access hardened against the supply-chain attacks that now hit companies of every size.</p>
      </li>
      <li>
        <h3>Answers ready</h3>
        <p>Clear evidence of how code is reviewed, built and released, for security questionnaires, audits and due diligence.</p>
      </li>
      <li>
        <h3>AI without the keys</h3>
        <p>Use AI coding and review tools while a person still approves everything that reaches production.</p>
      </li>
      <li>
        <h3>No slower shipping</h3>
        <p>Checks run automatically on every pull request. Engineers keep working the way they do today.</p>
      </li>
    </ul>
  </section>

  <section id="packages" aria-labelledby="packages-heading">
    <h2 id="packages-heading">Three fixed-scope packages</h2>
    <p>Each has a fixed scope and a fixed price, agreed before work starts, and ends with a handover.</p>
    <ul class="cards">
      {packages.map((p) => (
        <li class="card">
          <h3><a href={href(p.path)}>{p.name}</a></h3>
          <p>{p.summary}</p>
          <p class="small"><strong>You receive:</strong> {p.receive}</p>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="work-heading">
    <h2 id="work-heading">How we work</h2>
    <ol class="steps">
      <li><strong>Agree the scope.</strong> What is included, what you receive and the price, in writing, before any work starts.</li>
      <li><strong>Work in your repositories.</strong> Every change is a pull request your team reviews, so nothing happens out of sight.</li>
      <li><strong>Hand over.</strong> Documentation and a handover session. You own everything, with no retainer and no lock-in.</li>
    </ol>
  </section>

  <section aria-labelledby="open-heading">
    <h2 id="open-heading">Built in the open</h2>
    <p>
      This website is built, checked and deployed by the same workflows we set up for clients. The
      repositories, the rules that protect them and every change to them are public.
    </p>
    <p><a href={href("how-we-build/")}>How we build</a> &middot; <a href={href("demo/")}>The demo repositories</a></p>
  </section>
</Base>
