---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { href } from "../../lib";
import { article as articleSchema, breadcrumbs } from "../../schema";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const fmt = new Intl.DateTimeFormat("en-GB", { dateStyle: "long" });
const path = `articles/${article.id}/`;
const schema = [
  articleSchema({ title: article.data.title, description: article.data.description, path, date: article.data.date, updated: article.data.updated }),
  breadcrumbs([{ name: "Articles", path: "articles/" }, { name: article.data.title, path }]),
];
---

<Base title={article.data.title} description={article.data.description} type="article" schema={schema}>
  <article class="prose">
    <a class="eyebrow" href={href("articles/")}>Articles</a>
    <h1>{article.data.title}</h1>
    <p class="article-meta">
      By Fraser Davidson · <time datetime={article.data.date.toISOString().slice(0, 10)}>{fmt.format(article.data.date)}</time>
      {article.data.updated && <> · Updated <time datetime={article.data.updated.toISOString().slice(0, 10)}>{fmt.format(article.data.updated)}</time></>}
    </p>
    <Content />
  </article>
  <section aria-labelledby="more-heading">
    <h2 id="more-heading">More</h2>
    <div class="actions">
      <a class="button-secondary" href={href("articles/")}>All articles</a>
      <a class="button-secondary" href={href("how-we-build/")}>How we build</a>
    </div>
  </section>
</Base>
