---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { href } from "../../lib";

const articles = (await getCollection("articles", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const fmt = new Intl.DateTimeFormat("en-GB", { dateStyle: "long" });
---

<Base title="Articles" description="Practical writing on CI/CD security, GitHub Actions, software supply chains and AI code review.">
  <h1>Articles</h1>
  <p class="lead">Practical notes from building and securing delivery pipelines.</p>
  <ul class="article-list">
    {articles.map((article) => (
      <li>
        <h2><a href={href(`articles/${article.id}/`)}>{article.data.title}</a></h2>
        <p class="small"><time datetime={article.data.date.toISOString().slice(0, 10)}>{fmt.format(article.data.date)}</time></p>
        <p>{article.data.description}</p>
      </li>
    ))}
  </ul>
</Base>
