---
import Meta from "../components/Meta.astro";
import { href, nav, packages, site } from "../lib";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  type?: "website" | "article";
  canonical?: boolean;
  /** Preload the typeface. Set on the home page, where it matters most. */
  preloadFont?: boolean;
}

const { title, description, type, canonical, preloadFont = false } = Astro.props;
const current = Astro.url.pathname;
const year = new Date().getFullYear();
const isCurrent = (path: string) => !path.startsWith("#") && current.startsWith(href(path));
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={href("favicon.svg")} type="image/svg+xml" />
    {preloadFont && <link rel="preload" href={href("fonts/inter-latin-wght-normal.woff2")} as="font" type="font/woff2" crossorigin />}
    <Meta title={title} description={description} type={type} canonical={canonical} />
    <link rel="sitemap" href={href("sitemap-index.xml")} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={href("")}>
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true"><rect class="mark-bg" width="32" height="32" rx="7" /><path class="mark-l" d="M10 7v18h13v-4h-9V7z" /></svg>
          {site.name}
        </a>
        <div class="nav-desktop">
          <nav aria-label="Main">
            <ul>
              {nav.map((item) => (
                <li><a href={href(item.path)} aria-current={isCurrent(item.path) ? "page" : undefined}>{item.label}</a></li>
              ))}
            </ul>
          </nav>
          <a class="button button--small" href={href("contact/")}>Talk to us</a>
        </div>
        <details class="nav-menu">
          <summary>Menu</summary>
          <nav aria-label="Main menu">
            <ul>
              {nav.map((item) => (
                <li><a href={href(item.path)} aria-current={isCurrent(item.path) ? "page" : undefined}>{item.label}</a></li>
              ))}
            </ul>
            <a class="button" href={href("contact/")}>Talk to us</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main" class="page">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-about">
            <a class="brand" href={href("")}>
              <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true"><rect class="mark-bg" width="32" height="32" rx="7" /><path class="mark-l" d="M10 7v18h13v-4h-9V7z" /></svg>
              {site.name}
            </a>
            <p>From laptop to production, set up properly and handed over.</p>
          </div>
          <div class="footer-col">
            <h2>Services</h2>
            <ul>
              {packages.map((p) => <li><a href={href(p.path)}>{p.name}</a></li>)}
              <li><a href={href("pricing/")}>Pricing</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h2>Company</h2>
            <ul>
              <li><a href={href("about/")}>About</a></li>
              <li><a href={href("how-we-build/")}>How we build</a></li>
              <li><a href={href("contact/")}>Contact</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h2>Resources</h2>
            <ul>
              <li><a href={href("articles/")}>Articles</a></li>
              <li><a href={href("demo/")}>Demo repositories</a></li>
              <li><a href={site.github}>GitHub</a></li>
              <li><a href={href(".well-known/security.txt")}>Security contact</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-base">
          <p>&copy; {year} {site.name}</p>
          <p>Built and deployed by the workflows it describes. <a href={href("how-we-build/")}>See how</a>.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
