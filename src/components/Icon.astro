---
// Small line icons, drawn inline so they need no request and follow the
// text colour in light and dark mode.
interface Props {
  name: "review" | "shield" | "review-ai";
}
const { name } = Astro.props;
---

<span class="icon" aria-hidden="true">
  <svg viewBox="0 0 24 24">
    {name === "review" && (
      <>
        <circle cx="10.5" cy="10.5" r="6.5" />
        <path d="M15.5 15.5L21 21" />
        <path d="M7.75 10.75l2 2 3.5-4" />
      </>
    )}
    {name === "shield" && (
      <>
        <path d="M12 2.75l7.5 3v6c0 4.5-3.1 8.1-7.5 9.5-4.4-1.4-7.5-5-7.5-9.5v-6z" />
        <path d="M8.75 12l2.25 2.25 4.25-4.5" />
      </>
    )}
    {name === "review-ai" && (
      <>
        <path d="M4 5.5h16v10.5H9l-5 4z" />
        <path d="M12 7.75l.9 2.1 2.1.9-2.1.9-.9 2.1-.9-2.1-2.1-.9 2.1-.9z" />
      </>
    )}
  </svg>
</span>
